{
  "name": "@dead-sector/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dead Sector desktop shell (Electron), packaged as a snap",
  "author": "Marcel Savegnago",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/gamestudio42/dead-sector",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @dead-sector/game build && tsc -p tsconfig.json && node scripts/copy-game.mjs",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && electron . --smoke",
    "bench": "pnpm build && electron . --bench",
    "dist:dir": "pnpm build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "io.github.gamestudio42.DeadSector",
    "productName": "Dead Sector",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "game/**",
      "preload.cjs",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Pausable real-time squad tactics in a zombie outbreak",
      "executableName": "dead-sector"
    },
    "publish": []
  }
}
