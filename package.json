{
  "name": "dead-sector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @dead-sector/game dev",
    "build": "pnpm --filter @dead-sector/game build",
    "preview": "pnpm --filter @dead-sector/game preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @dead-sector/game e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "balance": "BALANCE_REPORT=1 vitest run packages/sim/test/balance.report.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
